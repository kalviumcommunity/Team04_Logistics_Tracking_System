DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/deliversync"
JWT_SECRET="deliversync-jwt-secret-key-change-in-production"
PORT=5000
NODE_ENV=development

# Email Service Configuration (SMTP / Gmail / Brevo / SendGrid / Custom Relay)
EMAIL_SERVICE="" # e.g. "gmail" or leave empty for custom SMTP
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false # Set to true for port 465 (SSL), false for port 587 (TLS/STARTTLS)
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password" # For Gmail: use a 16-character Google App Password
EMAIL_FROM="DeliverSync Logistics <no-reply@deliversync.com>"
